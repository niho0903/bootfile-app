# Copy values into the intended deployment environment through the provider's secret controls.
# This file contains names and safe defaults, never usable credentials.
NEXT_PUBLIC_BASE_URL=https://bootfile.ai
STUDIO_BASE_URL=https://bootfile.ai
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
ANTHROPIC_API_KEY=
RESEND_API_KEY=
STUDIO_ACCESS_TOKEN_SECRET=
CRON_SECRET=
ADMIN_PASSWORD=
GROWTH_AGENT_SECRET=
GROWTH_PUBLISHER_SECRET=

# Activate after the release checks in docs/OPERATIONS_RUNBOOK.md succeed.
STUDIO_CHECKOUT_ENABLED=false
STUDIO_FULFILLMENT_ENABLED=false
STUDIO_REFUNDS_ENABLED=false
BOOTFILE_OPERATIONS_PAUSED=false
STUDIO_MODEL=claude-haiku-4-5-20251001
STUDIO_MAX_GENERATIONS_PER_DAY=20

# Owned-blog reviews/publication use a separate credential and a two-per-week ledger cap.
GROWTH_REVIEW_ENABLED=false
GROWTH_PUBLICATION_ENABLED=false
GROWTH_REVIEW_MODEL=claude-sonnet-4-6

# Legacy promotional generation and email routes remain paused during the transition.
LEGACY_GROWTH_ENABLED=false
LEGACY_AD_CONVERSIONS_ENABLED=false
