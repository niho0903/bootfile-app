+import { config } from './config.js';
+import { logAction } from './logger.js';
+
+/** Optional Railway heartbeat for hosts whose native cron tier cannot run every five minutes. */
+export async function runBootfileOperations(): Promise<void> {
+  const response = await fetch(config.operationsUrl(), {
+    headers: { Authorization: `Bearer ${config.operationsSecret()}` },
+    signal: AbortSignal.timeout(290_000), redirect: 'error',
+  });
+  if (!response.ok) throw new Error(`Bootfile operations returned HTTP ${response.status}; inspect the app run ledger before retrying`);
+  const data = await response.json() as { status?: unknown; runId?: unknown; reason?: unknown };
+  if (!['completed', 'partial', 'paused', 'skipped'].includes(String(data.status))) throw new Error('Bootfile operations returned an unrecognized outcome');
+  logAction('Bootfile operations response observed', {
+    status: String(data.status), runId: typeof data.runId === 'string' ? data.runId : null,
+    reason: typeof data.reason === 'string' ? data.reason : null,
+  });
+}
