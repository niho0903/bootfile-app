+import { afterEach, test } from 'node:test';
+import assert from 'node:assert/strict';
+import { config, validatedServiceUrl } from './config.js';
+import { dailyJobKey, weekJobKey } from './product.js';
+import { runBootfileOperations } from './operations.js';
+import { draftExists } from './drafts.js';
+import { runOwnedBlogPublisher } from './publishing.js';
+
+const originalFetch = globalThis.fetch;
+const previousEnvironment = { ...process.env };
+afterEach(() => { globalThis.fetch = originalFetch; process.env = { ...previousEnvironment }; });
+
+test('capabilities fail closed until explicitly enabled', () => {
+  delete process.env.GROWTH_DRAFTS_ENABLED;
+  delete process.env.OPERATIONS_SCHEDULER_ENABLED;
+  delete process.env.GROWTH_PUBLISHER_ENABLED;
+  assert.equal(config.draftsEnabled(), false);
+  assert.equal(config.operationsEnabled(), false);
+  assert.equal(config.publisherEnabled(), false);
+  process.env.GROWTH_DRAFTS_ENABLED = 'yes';
+  assert.equal(config.draftsEnabled(), false);
+});
+
+test('publisher sends only its trigger and separate credential, never a self-approved payload', async () => {
+  process.env.BOOTFILE_PUBLISHER_URL = 'https://bootfile.ai/api/operations/publish';
+  process.env.GROWTH_PUBLISHER_SECRET = 'test-publisher-credential';
+  process.env.GROWTH_AGENT_SECRET = 'test-author-credential';
+  globalThis.fetch = (async (_url: unknown, init?: RequestInit) => {
+    assert.equal(init?.redirect, 'error'); assert.equal(init?.method, 'POST'); assert.equal(init?.body, '{}');
+    assert.equal((init?.headers as Record<string,string>).Authorization, 'Bearer test-publisher-credential');
+    return new Response(JSON.stringify({ status: 'approved', reason: 'publication_disabled' }), { status: 200 });
+  }) as typeof fetch;
+  await runOwnedBlogPublisher();
+});
+
+test('credential destinations require HTTPS and the exact service path', () => {
+  assert.throws(() => validatedServiceUrl('http://bootfile.ai/api/operations/run', '/api/operations/run'));
+  assert.throws(() => validatedServiceUrl('https://secret@bootfile.ai/api/operations/run', '/api/operations/run'));
+  assert.throws(() => validatedServiceUrl('https://bootfile.ai/api/operations/run?token=x', '/api/operations/run'));
+  assert.throws(() => validatedServiceUrl('https://bootfile.ai/api/admin/publish', '/api/operations/run'));
+  assert.equal(validatedServiceUrl('https://bootfile.ai/api/operations/run', '/api/operations/run').pathname, '/api/operations/run');
+});
+
+test('task keys stay stable through a daily or weekly restart', () => {
+  assert.equal(dailyJobKey('blog', new Date('2026-10-20T01:00:00Z')), dailyJobKey('blog', new Date('2026-10-20T23:00:00Z')));
+  assert.equal(weekJobKey(new Date('2026-10-19T00:00:00Z')), weekJobKey(new Date('2026-10-25T23:00:00Z')));
+  assert.notEqual(weekJobKey(new Date('2026-10-25T23:00:00Z')), weekJobKey(new Date('2026-10-26T00:00:00Z')));
+});
+
+test('paid operations refuses redirects and sends only the dedicated credential', async () => {
+  process.env.BOOTFILE_OPERATIONS_URL = 'https://bootfile.ai/api/operations/run';
+  process.env.BOOTFILE_CRON_SECRET = 'test-operations-credential';
+  let calls = 0;
+  globalThis.fetch = (async (_url: unknown, init?: RequestInit) => {
+    calls += 1;
+    assert.equal(init?.redirect, 'error');
+    assert.deepEqual(init?.headers, { Authorization: 'Bearer test-operations-credential' });
+    return new Response(JSON.stringify({ status: 'skipped' }), { status: 200 });
+  }) as typeof fetch;
+  await runBootfileOperations();
+  assert.equal(calls, 1);
+});
+
+test('an unavailable draft ledger fails the task before generation', async () => {
+  process.env.BOOTFILE_APP_URL = 'https://bootfile.ai';
+  process.env.GROWTH_AGENT_SECRET = 'test-draft-credential';
+  globalThis.fetch = (async () => new Response('unavailable', { status: 503 })) as typeof fetch;
+  await assert.rejects(() => draftExists('blog', 'blog:2026-10-20'), /ledger check failed/);
+});
