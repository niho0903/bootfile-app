+
+export function dailyJobKey(task: string, now = new Date()): string {
+  return `${task}:${now.toISOString().slice(0, 10)}`;
+}
+
+export function weekJobKey(now = new Date()): string {
+  const monday = new Date(Date.UTC(now.getUTCFullYear(), now.getUTCMonth(), now.getUTCDate()));
+  monday.setUTCDate(monday.getUTCDate() - ((monday.getUTCDay() + 6) % 7));
+  return `research:${monday.toISOString().slice(0, 10)}`;
