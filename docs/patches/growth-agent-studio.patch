@@ -0,0 +1,35 @@
+import { config } from './config.js';
+import { PRODUCT_VERSION } from './product.js';
+
+export type DraftChannel = 'blog' | 'instagram';
+
+function endpoint(): URL {
+  return new URL('/api/operations/drafts', config.appUrl());
+}
+
+export async function draftExists(channel: DraftChannel, jobKey: string): Promise<boolean> {
+  const url = endpoint();
+  url.searchParams.set('channel', channel);
+  url.searchParams.set('jobKey', jobKey);
+  const response = await fetch(url, {
+    headers: { Authorization: `Bearer ${config.growthSecret()}` },
+    signal: AbortSignal.timeout(15_000), redirect: 'error',
+  });
+  if (!response.ok) throw new Error(`Draft ledger check failed with HTTP ${response.status}`);
+  const data = await response.json() as { exists?: unknown };
+  if (typeof data.exists !== 'boolean') throw new Error('Draft ledger returned an invalid response');
+  return data.exists;
+}
+
+export async function saveDraft(channel: DraftChannel, jobKey: string, content: string, metadata: Record<string, unknown>): Promise<string> {
+  const response = await fetch(endpoint(), {
+    method: 'POST',
+    headers: { Authorization: `Bearer ${config.growthSecret()}`, 'Content-Type': 'application/json', Origin: config.appUrl() },
+    body: JSON.stringify({ channel, jobKey, content, metadata, productVersion: PRODUCT_VERSION }),
+    signal: AbortSignal.timeout(20_000), redirect: 'error',
+  });
+  if (!response.ok) throw new Error(`Draft persistence failed with HTTP ${response.status}`);
+  const data = await response.json() as { persisted?: unknown; id?: unknown };
+  if (data.persisted !== true || typeof data.id !== 'string') throw new Error('Draft persistence was not confirmed');
+  return data.id;
+}
